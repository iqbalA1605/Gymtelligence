<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gw_background">

    <include layout="@layout/component_step_indicator" android:id="@+id/stepIndicator" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/your_level_title"
            android:textColor="@color/gw_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/your_level_subtitle"
            android:textColor="@color/gw_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="18dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/exercise_label">

            <AutoCompleteTextView
                android:id="@+id/dropdownExercise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:text="Bench Press" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/weight_lifted_label"
                android:textColor="@color/gw_text_primary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLevelWeightMinus"
                style="@style/GwStepperButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="-" />

            <TextView
                android:id="@+id/textLevelWeightValue"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="30 kg"
                android:textColor="@color/gw_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLevelWeightPlus"
                style="@style/GwStepperButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="+" />

        </LinearLayout>

        <View style="@style/GwDivider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reps_till_tired_label"
                android:textColor="@color/gw_text_primary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRepsMinus"
                style="@style/GwStepperButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="-" />

            <TextView
                android:id="@+id/textRepsValue"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/gw_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRepsPlus"
                style="@style/GwStepperButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="+" />

        </LinearLayout>

        <View style="@style/GwDivider" android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/gw_primary_light"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/estimated_1rm_label"
                android:textColor="@color/gw_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/text1RMResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="35 kg"
                android:textColor="@color/gw_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textBeginnerLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/beginner_no_estimate_link"
            android:textColor="@color/gw_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/gw_surface"
        android:elevation="8dp"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackYourLevel"
            style="@style/GwSecondaryButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="@string/btn_back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextYourLevel"
            style="@style/GwPrimaryButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="2"
            android:text="@string/btn_next" />
    </LinearLayout>

</LinearLayout>
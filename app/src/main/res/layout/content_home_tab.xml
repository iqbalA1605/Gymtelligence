<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contentHomeTab"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gw_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/gw_surface"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_back"
                    android:textColor="@color/gw_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textUserPlanTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Plan"
                    android:textColor="@color/gw_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/GwOptionCard"
                android:layout_margin="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textPlanBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today · Push Day"
                        android:textColor="@color/gw_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@color/gw_primary_light"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/textPlanTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chest, Shoulders &amp; Triceps"
                        android:textColor="@color/gw_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textPlanSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="4 exercises · ~50 min · Moderate intensity"
                        android:textColor="@color/gw_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:id="@+id/exerciseListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                    <!-- Exercise rows added dynamically in Java -->

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/GwOptionCard"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textReadinessScore"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:text="84"
                        android:textColor="@color/gw_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_icon_circle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/readiness_score_label"
                            android:textColor="@color/gw_text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/textReadinessMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Good — push a bit today"
                            android:textColor="@color/gw_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
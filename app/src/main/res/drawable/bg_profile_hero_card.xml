<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main surface -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#151817" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#2A2E2C" />
        </shape>
    </item>
    <!-- Lime lighting effect centered behind avatar -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="200dp"
                android:centerX="0.5"
                android:centerY="0.35"
                android:startColor="#2A331A"
                android:endColor="#00000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
